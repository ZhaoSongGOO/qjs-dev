config("public") {
  defines = [
    "CONFIG_VERSION=\"TEST\"",
    "CONFIG_BIGNUM=y",
  ]
}

shared_library("qjs") {
  configs += [ ":public" ]
  sources = [
    "cutils.c",
    "cutils.h",
    "libbf.c",
    "libbf.h",
    "libregexp-opcode.h",
    "libregexp.c",
    "libregexp.h",
    "libunicode-table.h",
    "libunicode.c",
    "libunicode.h",
    "list.h",
    "quickjs-atom.h",
    "quickjs-libc.c",
    "quickjs-libc.h",
    "quickjs-opcode.h",
    "quickjs.c",
    "quickjs.h",
  ]
}

executable("demo") {
  sources = [ "demo.c" ]
  deps = [ ":qjs" ]
}

executable("call_js_prop") {
  sources = [ "call_js_prop.c" ]
  deps = [ ":qjs" ]
}

executable("inject_native_object") {
  sources = [ "inject_native_object.c" ]
  deps = [ ":qjs" ]
}

executable("inject_native_type") {
  sources = [ "inject_native_type.c" ]
  deps = [ ":qjs" ]
}
